#!/usr/bin/env sh

# PRE-PUSH HOOK - Проверка перед пушем
# Этот скрипт запускается перед каждым git push
# Он проверяет и исправляет ошибки, блокируя пуш если есть проблемы

set -e

# Цвета для вывода
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

echo ""
echo "============================================"
echo "${CYAN}🔍 PRE-PUSH CHECK${NC}"
echo "Проверка проекта перед push..."
echo "============================================"
echo ""

# Переходим в корень проекта
cd "$(git rev-parse --show-toplevel)"

ERRORS=0
WARNINGS=0
FIXES=0

# ============================================
# 1. ПРОВЕРКА FORMATTING (Prettier)
# ============================================
echo -e "${CYAN}[1/5]${NC} Checking formatting..."

if npx prettier --check "**/*.{ts,tsx,js,jsx,css,md,json}" --no-error-on-unmatched-pattern 2>/dev/null; then
    echo -e "${GREEN}✓ Formatting OK${NC}"
else
    echo -e "${YELLOW}! Formatting issues found, auto-fixing...${NC}"
    npx prettier --write "**/*.{ts,tsx,js,jsx,css,md,json}" --no-error-on-unmatched-pattern 2>/dev/null
    git add -A
    FIXES=$((FIXES + 1))
    echo -e "${GREEN}✓ Formatting fixed${NC}"
fi

# ============================================
# 2. ПРОВЕРКА TYPESCRIPT
# ============================================
echo -e "${CYAN}[2/5]${NC} Checking TypeScript..."

TS_ERRORS=$(npx tsc --noEmit 2>&1 || true)

if [ -z "$TS_ERRORS" ]; then
    echo -e "${GREEN}✓ TypeScript OK${NC}"
else
    TS_COUNT=$(echo "$TS_ERRORS" | grep -c "error TS" || true)
    if [ "$TS_COUNT" -gt 0 ]; then
        echo -e "${RED}✗ TypeScript errors: $TS_COUNT${NC}"
        echo "$TS_ERRORS" | head -20
        ERRORS=$((ERRORS + 1))
    else
        echo -e "${GREEN}✓ TypeScript OK (warnings only)${NC}"
    fi
fi

# ============================================
# 3. ПРОВЕРКА BUILD
# ============================================
echo -e "${CYAN}[3/5]${NC} Checking build..."

if bun run build 2>&1 | grep -q "error"; then
    echo -e "${RED}✗ Build failed${NC}"
    ERRORS=$((ERRORS + 1))
else
    echo -e "${GREEN}✓ Build OK${NC}"
fi

# ============================================
# 4. ПРОВЕРКА YAML ФАЙЛОВ
# ============================================
echo -e "${CYAN}[4/5]${NC} Checking YAML files..."

YAML_ERROR=0
for f in .github/**/*.yml .github/**/*.yaml dependabot.yml .dependabot.yml; do
    if [ -f "$f" ]; then
        if ! python3 -c "import yaml; yaml.safe_load(open('$f'))" 2>/dev/null; then
            echo -e "${RED}✗ Invalid YAML: $f${NC}"
            YAML_ERROR=1
        fi
    fi
done

if [ $YAML_ERROR -eq 0 ]; then
    echo -e "${GREEN}✓ YAML files OK${NC}"
else
    ERRORS=$((ERRORS + 1))
fi

# ============================================
# 5. ПРОВЕРКА PACKAGE.JSON
# ============================================
echo -e "${CYAN}[5/6]${NC} Checking package.json..."

if node -e "JSON.parse(require('fs').readFileSync('package.json', 'utf8'))" 2>/dev/null; then
    echo -e "${GREEN}✓ package.json OK${NC}"
else
    echo -e "${RED}✗ Invalid package.json${NC}"
    ERRORS=$((ERRORS + 1))
fi

# ============================================
# 6. ПРОВЕРКА ПРАВИЛ (ENFORCE-RULES)
# ============================================
echo -e "${CYAN}[6/6]${NC} Checking code rules..."

if node scripts/enforce-rules.mjs 2>/dev/null; then
    echo -e "${GREEN}✓ Code rules OK${NC}"
else
    echo -e "${RED}✗ Code rules check failed${NC}"
    echo ""
    echo "Обнаружены проблемы:"
    echo "  • Запрещённые цвета (#fff, #000 → используйте DESIGN-SYSTEM.md)"
    echo "  • Magic numbers → используйте значения из дизайн-системы"
    echo "  • console.log → удалите перед коммитом"
    echo ""
    echo "Запустите bun run enforce-rules для деталей"
    ERRORS=$((ERRORS + 1))
fi

# ============================================
# ИТОГ
# ============================================
echo ""
echo "============================================"

if [ $ERRORS -gt 0 ]; then
    echo -e "${RED}❌ PUSH BLOCKED - $ERRORS error(s) found${NC}"
    echo ""
    echo "Исправьте ошибки и попробуйте снова:"
    echo "  • Запустите: bun run build"
    echo "  • Запустите: npx tsc --noEmit"
    echo "  • Запустите: bun run enforce-rules"
    echo "  • Проверьте: git status"
    echo ""
    echo "Если исправления были применены автоматически:"
    echo "  git commit -am 'chore: fix pre-push issues'"
    echo "  git push"
    echo "============================================"
    exit 1
elif [ $FIXES -gt 0 ]; then
    echo -e "${YELLOW}⚠️  PUSH WITH AUTO-FIXES ($FIXES fix applied)${NC}"
    echo ""
    echo "Были применены автоматические исправления."
    echo "Они будут включены в текущий push."
    echo "============================================"
    exit 0
else
    echo -e "${GREEN}✅ ALL CHECKS PASSED - Push allowed${NC}"
    echo "============================================"
    exit 0
fi
