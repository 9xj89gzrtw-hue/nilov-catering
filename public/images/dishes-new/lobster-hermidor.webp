[\"$\",\"meta\",\"10\",{\"property\":\"og:locale\",\"content\":\"ru_RU\"}],[\"$\",\"meta\",\"11\",{\"property\":\"og:image\",\"content\":\"https://nilov-catering.vercel.app/opengraph-image?b6c0974973b2a830\"}],[\"$\",\"meta\",\"12\",{\"property\":\"og:image:type\",\"content\":\"image/png\"}],[\"$\",\"meta\",\"13\",{\"property\":\"og:image:width\",\"content\":\"1200\"}],[\"$\",\"meta\",\"14\",{\"property\":\"og:image:height\",\"content\":\"630\"}],[\"$\",\"meta\",\"15\",{\"property\":\"og:image:alt\",\"content\":\"NiloV Catering — Кейтеринг под ключ в Санкт-Петербурге\"}],[\"$\",\"meta\",\"16\",{\"property\":\"og:type\",\"content\":\"website\"}],[\"$\",\"meta\",\"17\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"18\",{\"name\":\"twitter:title\",\"content\":\"NiloV Catering — кейтеринг в СПб\"}],[\"$\",\"meta\",\"19\",{\"name\":\"twitter:description\",\"content\":\"Фуршет от 2 450 ₽, банкет от 3 950 ₽, кофе-брейк от 390 ₽/гость. С 2007 года.\"}],[\"$\",\"meta\",\"20\",{\"name\":\"twitter:image\",\"content\":\"https://nilov-catering.vercel.app/opengraph-image?b6c0974973b2a830\"}],[\"$\",\"meta\",\"21\",{\"name\":\"twitter:image:alt\",\"content\":\"NiloV Catering — Кейтеринг под ключ в Санкт-Петербурге\"}],[\"$\",\"meta\",\"22\",{\"name\":\"twitter:image:type\",\"content\":\"image/png\"}],[\"$\",\"meta\",\"23\",{\"name\":\"twitter:image:width\",\"content\":\"1200\"}],[\"$\",\"meta\",\"24\",{\"name\":\"twitter:image:height\",\"content\":\"630\"}],[\"$\",\"link\",\"25\",{\"rel\":\"icon\",\"href\":\"/icon?4d11f8a9abdf1e09\",\"alt\":\"$undefined\",\"type\":\"image/png\",\"sizes\":\"32x32\"}],[\"$\",\"$Lf\",\"26\",{}]]\n10:I[30746,[\"/_next/static/chunks/42xh0ots2d2wq.js\",\"/_next/static/chunks/187-p0r3usbex.js\",\"/_next/static/chunks/0w69cuh64p1il.js\",\"/_next/static/chunks/244kzfxrbosar.js\",\"/_next/static/chunks/0udvi5t1kv3jr.js\"],\"default\"]\n:HL[\"/styles/print.css\",\"style\",{\"media\":\"print\"}]\n11:T1149,{\"@context\":\"https://schema.org\",\"@type\":\"LocalBusiness\",\"@id\":\"https://nilov-catering.vercel.app/#organization\",\"name\":\"NiloV Catering\",\"legalName\":\"Индивидуальный предприниматель Нилов Дмитрий Игоревич\",\"url\":\"https://nilov-catering.vercel.app\",\"telephone\":\"+78129195911\",\"email\":\"info@nilov-catering.ru\",\"image\":[\"https://nilov-catering.vercel.app/images/catering/wedding-01.jpg\"],\"address\":{\"@type\":\"PostalAddress\",\"addressLocality\":\"Санкт-Петербург\",\"addressCountry\":\"RU\",\"streetAddress\":\"199106, г. Санкт-Петербург, Василеостровский район, 20-я линия, дом 11, помещение 5-Н\",\"postalCode\":\"199106\"},\"geo\":{\"@type\":\"GeoCoordinates\",\"latitude\":59.931038,\"longitude\":30.276615},\"hasMap\":\"https://yandex.ru/maps/?ll=30.276615,59.931038\u0026z=17\",\"priceRange\":\"₽₽₽\",\"taxID\":\"781433059704\",\"foundingDate\":\"2007\",\"areaServed\":\"Санкт-Петербург и Ленинградская область\",\"sameAs\":[\"https://vk.com/nilovcatering\",\"https://t.me/nilovcatering\"],\"openingHoursSpecification\":{\"@type\":\"OpeningHoursSpecification\",\"dayOfWeek\":[\"Monday\",\"Tuesday\",\"Wednesday\",\"Thursday\",\"Friday\",\"Saturday\",\"Sunday\"],\"opens\":\"09:00\",\"closes\":\"21:00\"},\"aggregateRating\":{\"@type\":\"AggregateRating\",\"ratingValue\":\"4.8\",\"reviewCount\":\"27\",\"bestRating\":\"5\",\"worstRating\":\"1\"},\"review\":[{\"@type\":\"Review\",\"author\":{\"@type\":\"Person\",\"name\":\"Екатерина и Дмитрий\"},\"reviewRating\":{\"@type\":\"Rating\",\"ratingValue\":\"5\",\"bestRating\":\"5\",\"worstRating\":\"1\"},\"datePublished\":\"2024-08-01\",\"reviewBody\":\"Свадебный банкет с 3 диетами (веганы + БГ + всеядные). Шеф Дмитрий предложил торт с безглютеновым ярусом для тёти — целиакия. Гости не заметили разницы, торт прекрасный. Персонал вежливый, подача чёткая по таймингу.\",\"name\":\"Свадьба\"},{\"@type\":\"Review\",\"author\":{\"@type\":\"Person\",\"name\":\"Мария А.\"},\"reviewRating\":{\"@type\":\"Rating\",\"ratingValue\":\"5\",\"bestRating\":\"5\",\"worstRating\":\"1\"},\"datePublished\":\"2024-05-01\",\"reviewBody\":\"У ребёнка аллергия на орехи. Прислали протокол безопасности: отдельные доски, EpiPen на руках у менеджера. В детском меню орехов не было вовсе — проще следить. Капкейки и пицца — детям зашло.\",\"name\":\"День рождения\"},{\"@type\":\"Review\",\"author\":{\"@type\":\"Person\",\"name\":\"Сергей П.\"},\"reviewRating\":{\"@type\":\"Rating\",\"ratingValue\":\"5\",\"bestRating\":\"5\",\"worstRating\":\"1\"},\"datePublished\":\"2024-12-01\",\"reviewBody\":\"Корпоратив на 50 человек с ЭДО (Диадок). ИП Нилов на УСН — без НДС, для нашей бухгалтерии на ОСН предложили партнёрское ООО. Счёт-фактура пришла на следующий день. Документы для бухгалтерии — без замечаний.\",\"name\":\"Корпоратив\"},{\"@type\":\"Review\",\"author\":{\"@type\":\"Person\",\"name\":\"Ольга Николаевна\"},\"reviewRating\":{\"@type\":\"Rating\",\"ratingValue\":\"4\",\"bestRating\":\"5\",\"worstRating\":\"1\"},\"datePublished\":\"2024-06-01\",\"reviewBody\":\"Выпускной 9 классов. Полный пакет документов для Роспотребнадзора: медкнижки, бракераж, ППК, декларация ЕАЭС. Согласование прошло без замечаний. Школьный пакет 1 800 ₽/гость — вписались в бюджет.\",\"name\":\"Выпускной\"},{\"@type\":\"Review\",\"author\":{\"@type\":\"Person\",\"name\":\"Игорь М.\"},\"reviewRating\":{\"@type\":\"Rating\",\"ratingValue\":\"5\",\"bestRating\":\"5\",\"worstRating\":\"1\"},\"datePublished\":\"2024-09-01\",\"reviewBody\":\"Халяль-меню на юбилей. Сертификат Совета муфтиев России прислали заранее. Забой по зибха. Отдельная посуда, без алкоголя. Баранина и плов — как дома. Не хватает только вина в меню, но это плюс для халяль.\",\"name\":\"Юбилей\"}]}2:[\"$\",\"html\",null,{\"lang\":\"ru\",\"className\":\"cormorant_garamond_dcfe491d-module__wqr3mG__variable inter_6a6f4972-module__b1Pora__variable jetbrains_mono_1c2eed3d-module__TIgtBa__variable\",\"children\":[\"$\",\"body\",null,{\"className\":\"bg-background text-foreground min-